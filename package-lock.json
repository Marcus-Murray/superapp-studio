{
  "name": "superapp-studio",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "superapp-studio",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/ideation-app": {
      "version": "0.0.1",
      "dependencies": {
        "@superapp/core": "0.0.1"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@superapp/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/ideation-app": {
      "resolved": "apps/ideation-app",
      "link": true
    },
    "packages/core": {
      "name": "@superapp/core",
      "version": "0.0.1",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
